[Unit]
Description=Voisu development Local pilot daemon
After=wayland-session-waitenv.service dbus.socket pipewire.service
Wants=dbus.socket pipewire.service
PartOf=graphical-session.target
Conflicts=voisu.service
Before=voisu.service
ConditionEnvironment=|WAYLAND_DISPLAY
ConditionEnvironment=|DISPLAY
StartLimitIntervalSec=30s
StartLimitBurst=3

[Service]
Type=simple
ExecStart=%h/Anuraj-dev/voisu/target/release/voisu-daemon --systemd
Environment=VOISU_ENABLE_DPR=1
Environment=VOISU_ENABLE_LOCAL_PILOT=1
Restart=on-failure
RestartSec=2s
TimeoutStopSec=60s

# Keep the production unit's sandbox. The dev service uses the same user
# config/state/runtime namespace so the existing CLI and Caps Lock binding
# continue to talk to whichever daemon is active.
NoNewPrivileges=yes
ProtectSystem=strict
ConfigurationDirectory=voisu
StateDirectory=voisu
ReadWritePaths=%t
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

[Install]
WantedBy=graphical-session.target
