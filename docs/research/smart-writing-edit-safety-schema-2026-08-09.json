{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Anuraj-dev/voisu/main/docs/research/smart-writing-edit-safety-schema-2026-08-09.json",
  "title": "Voisu Smart Writing grammar-edit safety corpus (#100 architecture reset)",
  "description": "Authoritative shape consumed by the hermetic stdlib validator in the paired prototype.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "version",
    "issue",
    "approval_state",
    "language",
    "architecture",
    "coordinate_system",
    "policy_under_test",
    "grammar_rule_catalog",
    "thresholds",
    "invariants",
    "error_codes",
    "fixtures",
    "dataset_counts"
  ],
  "properties": {
    "corpus_id": {
      "const": "voisu-smart-writing-edit-safety-2026-08-09"
    },
    "version": {
      "const": "4.0.0-architecture-reset"
    },
    "issue": {
      "$ref": "#/$defs/issue"
    },
    "approval_state": {
      "const": "approved_b1a_b2a_b3a"
    },
    "language": {
      "const": "en"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "coordinate_system": {
      "$ref": "#/$defs/coordinates"
    },
    "policy_under_test": {
      "$ref": "#/$defs/policy"
    },
    "grammar_rule_catalog": {
      "type": "array",
      "minItems": 3,
      "items": {
        "enum": [
          "G_THERE_IS_PLURAL_QUANTITY",
          "G_LETS_MEET_CONTRACTION",
          "G_DIDNT_APOSTROPHE"
        ]
      }
    },
    "thresholds": {
      "$ref": "#/$defs/thresholds"
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/named_summary"
      }
    },
    "error_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/error_code"
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "dataset_counts": {
      "$ref": "#/$defs/counts"
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_number",
        "title",
        "parent_map",
        "blocked_by",
        "blocks",
        "url"
      ],
      "properties": {
        "github_number": {
          "const": 100
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "parent_map": {
          "const": 96
        },
        "blocked_by": {
          "const": 99
        },
        "blocks": {
          "const": 103
        },
        "url": {
          "type": "string",
          "pattern": "^https://github[.]com/Anuraj-dev/voisu/issues/100$"
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatting_authority",
        "grammar_authority",
        "baseline_transport",
        "baseline_derivation",
        "whole_text_rewrite_rule",
        "context_source"
      ],
      "properties": {
        "formatting_authority": {
          "const": "deterministic_local_formatter"
        },
        "grammar_authority": {
          "const": "untrusted_localized_patches_only"
        },
        "baseline_transport": {
          "const": "sealed_typed_value_not_json"
        },
        "baseline_derivation": {
          "const": "immutable_formatter_contract_and_structural_digest"
        },
        "whole_text_rewrite_rule": {
          "const": "absent"
        },
        "context_source": {
          "const": "validated_transcript_only"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "interval",
        "boundary_rule",
        "grammar_span_rule",
        "zero_width_grammar"
      ],
      "properties": {
        "unit": {
          "const": "utf8_byte"
        },
        "interval": {
          "const": "half_open"
        },
        "boundary_rule": {
          "const": "must_be_char_boundary"
        },
        "grammar_span_rule": {
          "const": "exactly_one_whole_lexical_token"
        },
        "zero_width_grammar": {
          "const": "forbidden"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grammar_failure_unit",
        "stale_fallback",
        "protected_span_blast_radius",
        "composition",
        "ballot_status"
      ],
      "properties": {
        "grammar_failure_unit": {
          "const": "whole_candidate"
        },
        "stale_fallback": {
          "const": "keep_fresh_formatting_baseline"
        },
        "protected_span_blast_radius": {
          "const": "reject_grammar_keep_formatting"
        },
        "composition": {
          "const": "formatter_source_anchors_formatting_priority"
        },
        "ballot_status": {
          "const": "approved"
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "max_file_bytes",
        "max_json_depth",
        "max_json_nodes",
        "max_base_utf8_bytes",
        "max_edits",
        "max_edit_field_utf8_bytes",
        "max_diagnostic_utf8_bytes"
      ],
      "properties": {
        "owner": {
          "const": "research_defaults_issue_103_owns_release"
        },
        "max_file_bytes": {
          "const": 524288
        },
        "max_json_depth": {
          "const": 12
        },
        "max_json_nodes": {
          "const": 20000
        },
        "max_base_utf8_bytes": {
          "const": 100000
        },
        "max_edits": {
          "const": 64
        },
        "max_edit_field_utf8_bytes": {
          "const": 512
        },
        "max_diagnostic_utf8_bytes": {
          "const": 128
        }
      }
    },
    "named_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "error_code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "summary"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "version",
        "fingerprint"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "grammar_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_version",
        "base_fingerprint",
        "edits"
      ],
      "properties": {
        "base_version": {
          "type": "string",
          "minLength": 1
        },
        "base_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grammar_edit"
          }
        }
      }
    },
    "grammar_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_id",
        "start_utf8",
        "end_utf8",
        "before",
        "after"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "start_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "end_utf8": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "rendered",
        "error_codes"
      ],
      "properties": {
        "decision": {
          "enum": [
            "both",
            "formatting_only",
            "grammar_only",
            "unchanged"
          ]
        },
        "rendered": {
          "type": "string"
        },
        "error_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^E_[A-Z0-9_]+$"
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "roles",
        "base",
        "grammar_candidate",
        "protected_names",
        "dictionary_terms",
        "expected",
        "related_behavior_fixture_ids",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "base": {
          "$ref": "#/$defs/base"
        },
        "grammar_candidate": {
          "$ref": "#/$defs/grammar_candidate"
        },
        "protected_names": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dictionary_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "related_behavior_fixture_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F[0-9]+[a-z]?$"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtures_total",
        "fixtures_accept_grammar",
        "fixtures_reject_grammar",
        "fixtures_formatting_only",
        "notes"
      ],
      "properties": {
        "fixtures_total": {
          "type": "integer",
          "minimum": 1
        },
        "fixtures_accept_grammar": {
          "type": "integer",
          "minimum": 0
        },
        "fixtures_reject_grammar": {
          "type": "integer",
          "minimum": 0
        },
        "fixtures_formatting_only": {
          "type": "integer",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
