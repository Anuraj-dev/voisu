  "invariants": [
    {
      "id": "I-SILENT-OR-MINIMAL",
      "summary": "Feedback is silent by default; at most one non-blocking minimal_status on hard fallback after cloud attempt."
    },
    {
      "id": "I-NO-FALSE-CLOUD-SUCCESS",
      "summary": "Feedback never claims cloud success when baseline was Delivered."
    },
    {
      "id": "I-EVENT-ORDER",
      "summary": "route_selected first; cloud start before response/deadline/failure; exactly one composition or fallback before delivery; late after delivery; non-decreasing t_ms."
    },
    {
      "id": "I-ONE-CLOUD-CALL",
      "summary": "At most one cloud_request_started per recording."
    },
    {
      "id": "I-EVAL-LATE-RETAIN",
      "summary": "late_result_retained only in evaluation mode and only after delivery_emitted."
    },
    {
      "id": "I-PROD-NO-UPGRADE",
      "summary": "Production never retains late text for upgrade and never sets replace_delivered."
    },
    {
      "id": "I-UNSENT-DELIVERY",
      "summary": "Delivery is always unsent with auto_send/live_type/replace_delivered false."
    },
    {
      "id": "I-BOUNDED-PAYLOAD",
      "summary": "Events and retained late text respect package thresholds; no secrets or unbounded HTTP bodies."
    },
    {
      "id": "I-DEADLINE-1500",
      "summary": "Final-only Delivery deadline is 1500ms from utterance_end."
    }
  ],
  "production_cleanup": {
    "evaluation_only": [
      "event late_result_retained",
      "candidate_text_clamped full late text",
      "UI apply-late-result / upgrade transcript",
      "user-facing offline compare export",
      "mode defaulting to evaluation",
      "late text retention beyond fingerprint for upgrade"
    ],
    "retained_forever": [
      "ordered timing events",
      "failure class and E_* codes",
      "fallback trigger reason",
      "late_result_discarded timing-only optional fingerprint",
      "feedback kind",
      "unsent Delivery flags",
      "correlation id"
    ]
  },
