  },
  "approval_state": "approved_b1a_b2a_b3a",
  "language": "en",
  "architecture": {
    "formatting_authority": "deterministic_local_formatter",
    "grammar_authority": "untrusted_localized_patches_only",
    "baseline_transport": "sealed_typed_value_not_json",
    "baseline_derivation": "immutable_formatter_contract_and_structural_digest",
    "whole_text_rewrite_rule": "absent",
    "context_source": "validated_transcript_only"
  },
  "coordinate_system": {
    "unit": "utf8_byte",
    "interval": "half_open",
    "boundary_rule": "must_be_char_boundary",
    "grammar_span_rule": "exactly_one_whole_lexical_token",
    "zero_width_grammar": "forbidden"
  },
  "policy_under_test": {
    "grammar_failure_unit": "whole_candidate",
    "stale_fallback": "keep_fresh_formatting_baseline",
    "protected_span_blast_radius": "reject_grammar_keep_formatting",
    "composition": "formatter_source_anchors_formatting_priority",
    "ballot_status": "approved"
  },
  "grammar_rule_catalog": [
    "G_THERE_IS_PLURAL_QUANTITY",
    "G_LETS_MEET_CONTRACTION",
    "G_DIDNT_APOSTROPHE"
  ],
  "thresholds": {
    "owner": "research_defaults_issue_103_owns_release",
    "max_file_bytes": 524288,
    "max_json_depth": 12,
    "max_json_nodes": 20000,
    "max_base_utf8_bytes": 100000,
    "max_edits": 64,
    "max_edit_field_utf8_bytes": 512,
    "max_diagnostic_utf8_bytes": 128
  },
  "invariants": [
    {
      "id": "I-TYPED-BASELINE",
      "summary": "Formatting is immutable and sealed, with a verified contract and digest; provider JSON cannot construct it."
    },
    {
      "id": "I-NO-WHOLE-REWRITE",
      "summary": "The grammar catalog has no whole-text rewrite operation."
    },
    {
      "id": "I-VALIDATED-ANCHOR",
      "summary": "Every grammar edit is anchored to the immutable Validated Transcript."
    },
    {
      "id": "I-FORMATTING-PRIORITY",
      "summary": "Unsafe grammar retains the already-produced formatting baseline."
    },
    {
      "id": "I-PROTECTED",
      "summary": "Semantic spans and exact base-derived formatter quote/code/command ranges are protected."
    },
    {
      "id": "I-D3B",
      "summary": "List inference uses only the Validated Transcript and ambiguous prose remains prose."
    },
    {
      "id": "I-ERROR-ORDER",
      "summary": "Errors retain deterministic first-seen order."
    },
    {
      "id": "I-APPROVED-99",
      "summary": "Exact accepted outputs cross-link to the approved #99 corpus."
    }
  ],
  "error_codes": [
    {
      "code": "E_FORMATTING_TYPE",
