/target/

# RPM build artifacts (packaging/build-rpm.sh output)
/dist/

# makepkg output inside the AUR package dirs. Narrowly scoped so the committed
# PKGBUILD, .SRCINFO, *.install and LICENSE.ring-* sidecars stay tracked.
/packaging/aur/*/src/
/packaging/aur/*/pkg/
/packaging/aur/*/*.pkg.tar.*
/packaging/aur/*/*.tar.gz

# COPR Custom source-method scratch (packaging/copr/make-srpm.sh)
_copr_srpm/

# Private agent-workflow overlay (own git repo: Anuraj-dev/voisu-internal)
/internal/
/CLAUDE.md
/AGENTS.md

# Local secrets
.env
.env.*
!.env.example

# Private evaluator reports (developer-only; the crate itself stays tracked)
/tools/transcript-quality/out/
/tools/transcript-quality/target/
**/transcript-quality-report.json

# A real eval corpus (private audio + adjudicated references) may live here,
# but only because this exact path is gitignored. corpus.example/ stays
# tracked: it is synthetic and ships no audio.
/tools/transcript-quality/corpus/
